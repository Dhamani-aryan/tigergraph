TG_HOST=https://your-workspace.i.tgcloud.io
TG_GRAPHNAME=FraudInvestigation
TG_USERNAME=tigergraph
TG_PASSWORD=changeme
TG_RESTPP_PORT=9000
TG_GS_PORT=14240

LLM_BACKEND=groq
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

# --- LLM_BACKEND=pi: ChatGPT Plus/Pro through Pi's openai-codex OAuth provider ---
# Set LLM_BACKEND=pi to use these (GROQ_API_KEY is then not needed). Log in once with
# `node pi_bridge/bridge.mjs login`; Pi stores the OAuth credential in ~/.pi/agent/auth.json,
# never here. Pick PI_MODEL from `node pi_bridge/bridge.mjs models` (a non-Spark model).
PI_PROVIDER=openai-codex
PI_MODEL=your-pi-openai-codex-model
PI_REASONING_EFFORT=low
# Optional: path to a Node >= 22.19 binary if `node` on PATH is older.
PI_NODE=
PI_REQUEST_TIMEOUT_S=180
PI_STARTUP_TIMEOUT_S=60

# --- Ollama: OPTIONAL, not needed for investigations ---
# Live case runs (python -m scripts.run_batch) never call Ollama or localhost:11434:
# retrieval is TigerGraph structured candidates reranked by the reasoning model, and
# FraudCase writes store no embedding. Ollama (nomic-embed-text) is only used by the
# one-time knowledge-ingestion scripts and by the optional LLM_BACKEND=ollama.
